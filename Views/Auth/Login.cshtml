@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Ocean Luxury</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --ocean-blue: #0096c7;
            --sunny-sky: #48cae4;
            --deep-sea: #03045e;
        }

        body {
            /* Đổi sang hình nền bãi biển đầy nắng và cát trắng tươi sáng */
            background: url('https://images.unsplash.com/photo-1506929562872-bb421503ef21?q=80&w=2068&auto=format&fit=crop') center/cover no-repeat fixed;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }

        .ocean-container {
            display: flex;
            width: 1050px;
            height: 600px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 20px 45px rgba(0,0,0,0.15);
            overflow: hidden;
            animation: fadeInScale 0.6s ease-out;
        }

        .image-side {
            flex: 1;
            background: url('https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=2070&auto=format&fit=crop') center/cover;
            position: relative;
        }

        .image-overlay {
            position: absolute;
            bottom: 40px;
            left: 40px;
            color: white;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.4);
        }

        .form-side {
            flex: 1.2;
            padding: 50px 60px;
            background: rgba(255, 255, 255, 0.96);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .ocean-input {
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            padding: 12px 15px;
            transition: 0.3s;
        }

        .ocean-input:focus {
            border-color: var(--ocean-blue);
            box-shadow: 0 0 0 4px rgba(0, 150, 199, 0.15);
        }

        .btn-ocean {
            background: linear-gradient(135deg, var(--ocean-blue), var(--deep-sea));
            color: white;
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: 0.3s;
        }

        .btn-ocean:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 150, 199, 0.3);
            color: white;
        }

        .ocean-link {
            color: var(--ocean-blue);
            text-decoration: none;
            font-weight: 600;
        }

        .ocean-link:hover {
            color: var(--deep-sea);
        }

        @@keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
</head>
<body>
    <div class="ocean-container">
        <div class="image-side">
            <div class="image-overlay">
                <h1 class="fw-bold m-0">Ocean Resort</h1>
                <p class="lead opacity-90 m-0">Hệ thống quản lý khách sạn cao cấp</p>
            </div>
        </div>

        <div class="form-side">
            <div class="mb-4">
                <h2 class="fw-bold text-dark mb-1">ĐĂNG NHẬP</h2>
                <p class="text-muted small">Vui lòng đăng nhập tài khoản quản trị viên</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 shadow-sm mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Email công vụ</label>
                    <input type="email" name="email" class="form-control ocean-input" placeholder="admin@ocean.com" required>
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold text-secondary">Mật khẩu</label>
                    <input type="password" name="password" class="form-control ocean-input" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn btn-ocean w-100 mb-4 shadow-sm">ĐĂNG NHẬP HỆ THỐNG</button>
                
                <div class="text-center">
                    <span class="text-muted small">Bạn là Admin mới? <a asp-action="Register" class="ocean-link">Đăng ký tại đây</a></span>
                </div>
            </form>
        </div>
    </div>
</body>
</html>