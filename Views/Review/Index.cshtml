@model IEnumerable<Web_Management_Booking_N4.Models.Review>

@{
    ViewData["Title"] = "Quản Lý Đánh Giá & Phản Hồi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header { border-bottom: 2px dashed #caf0f8; padding-bottom: 15px; margin-bottom: 30px; }
    .table-responsive { background: white; border-radius: 16px; padding: 15px; }
    .ocean-table th { background-color: #f1f5f9 !important; color: #03045e !important; font-weight: 600; padding: 15px 12px; }
    .ocean-table td { padding: 15px 12px; vertical-align: middle; color: #334155; }
    
    /* Thiết kế hệ thống sao đánh giá */
    .star-rating { color: #ffb703; font-size: 14px; }
    .comment-box { background-color: #f8fafc; border-left: 3px solid #0284c7; padding: 6px 12px; border-radius: 4px; font-style: italic; max-width: 350px; }
</style>

<div class="page-header">
    <h2 class="fw-bold m-0" style="color: #0077b6 !important;"><i class="fas fa-star me-2"></i>Quản Lý Đánh Giá & Phản Hồi</h2>
    <p class="text-muted m-0 small">Lắng nghe ý kiến phản hồi của khách hàng để nâng cao chất lượng dịch vụ phòng nghỉ.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #e8f5e9; color: #2e7d32;">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive shadow-sm">
    <table class="table ocean-table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 60px;" class="text-center">STT</th>
                <th style="width: 200px;">Khách Hàng</th>
                <th style="width: 220px;">Cơ Sở / Khách Sạn</th>
                <th style="width: 130px;" class="text-center">Điểm Số</th>
                <th>Nội Dung Phản Hồi</th>
                <th style="width: 150px;" class="text-center">Thời Gian</th>
                <th style="width: 90px;" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-secondary">@index</td>
                        <td>
                            <strong class="text-dark">@(item.User?.FullName ?? "Ẩn danh")</strong>
                            <small class="text-muted d-block">@item.User?.Email</small>
                        </td>
                        <td>
                            <span class="fw-semibold text-dark"><i class="fas fa-hotel text-info me-1"></i> @(item.Property?.Name ?? "N/A")</span>
                        </td>
                        <td class="text-center">
                            <div class="star-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star" style="color: #cbd5e1;"></i>
                                    }
                                }
                            </div>
                            <span class="badge bg-light text-dark border mt-1">@item.Rating / 5 điểm</span>
                        </td>
                        <td>
                            <div class="comment-box text-wrap">
                                @(string.IsNullOrEmpty(item.Comment) ? "Chưa để lại bình luận chữ." : item.Comment)
                            </div>
                        </td>
                        <td class="text-center text-secondary small">
                            @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "--")
                        </td>
                        <td class="text-center">
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa vĩnh viễn đánh giá này không?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px; padding: 6px 12px;" title="Xóa đánh giá">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <i class="fas fa-comment-slash d-block fs-2 mb-3 text-secondary"></i>
                        Hiện chưa có khách hàng nào gửi đánh giá hoặc phản hồi về các cơ sở lưu trú.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>