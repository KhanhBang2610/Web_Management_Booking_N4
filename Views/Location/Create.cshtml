@model Web_Management_Booking_N4.Models.Location

@{
    ViewData["Title"] = "Thêm Địa Điểm Mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header {
        border-bottom: 2px dashed #caf0f8;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }

    .form-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0, 119, 182, 0.05);
        padding: 30px;
        max-width: 700px;
    }

    .form-label {
        color: #03045e;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .form-control-ocean {
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 12px 15px;
        font-size: 14px;
        transition: all 0.3s;
    }

    .form-control-ocean:focus {
        border-color: #00b4d8;
        box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.15);
        outline: none;
    }

    .btn-ocean-submit {
        background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-ocean-submit:hover {
        background: linear-gradient(135deg, #03045e 0%, #0077b6 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(0, 119, 182, 0.2);
    }

    .btn-ocean-cancel {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 500;
        transition: all 0.3s;
    }

    .btn-ocean-cancel:hover {
        background-color: #e2e8f0;
        color: #1e293b;
    }

    .text-danger-ocean {
        font-size: 12px;
        color: #ef4444;
        margin-top: 4px;
        font-weight: 500;
    }
</style>

<div class="page-header">
    <h2 class="fw-bold m-0" style="color: #0077b6 !important;">
        <i class="fas fa-plus-circle me-2"></i>Thêm Khai Thác Địa Điểm
    </h2>
    <p class="text-muted m-0 small">Mở rộng mạng lưới điểm đến cho chuỗi hệ thống Resort & Khách sạn Ocean Luxury.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="form-card w-100">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label">Tên Địa Điểm / Tỉnh Thành</label>
                <input asp-for="Name" class="form-control form-control-ocean w-100" placeholder="Ví dụ: Phú Quốc, Vũng Tàu, Nha Trang..." autocomplete="off" />
                <span asp-validation-for="Name" class="text-danger-ocean d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ImageUrl" class="form-label">Đường dẫn hình ảnh minh họa (URL)</label>
                <input asp-for="ImageUrl" class="form-control form-control-ocean w-100" placeholder="https://example.com/anh-dep.jpg" id="imageUrlInput" />
                <span asp-validation-for="ImageUrl" class="text-danger-ocean d-block"></span>
                <div class="form-text text-muted small mt-1">Gợi ý: Bạn có thể sao chép link ảnh phong cảnh trên mạng hoặc để trống (Hệ thống sẽ tự dùng ảnh mặc định).</div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label">Mô tả tóm tắt về khu vực</label>
                <textarea asp-for="Description" class="form-control form-control-ocean w-100" rows="4" placeholder="Chia sẻ một chút nét nổi bật về khí hậu, danh lam hoặc tiềm năng du lịch tại đây..."></textarea>
                <span asp-validation-for="Description" class="text-danger-ocean d-block"></span>
            </div>

            <div class="d-flex justify-content-end gap-3 pt-3 border-top" style="border-color: #f1f5f9 !important;">
                <a asp-action="Index" class="btn btn-ocean-cancel">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
                <button type="submit" class="btn btn-ocean-submit">
                    <i class="fas fa-save me-1"></i> Lưu thông tin
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}