@model IEnumerable<Web_Management_Booking_N4.Models.Location>

@{
    ViewData["Title"] = "Quản Lý Địa Điểm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header {
        border-bottom: 2px dashed #caf0f8;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }
    
    .btn-ocean {
        background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 500;
        transition: all 0.3s;
    }

    .btn-ocean:hover {
        background: linear-gradient(135deg, #03045e 0%, #0077b6 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(0, 119, 182, 0.2);
    }

    .table-responsive {
        background: white;
        border-radius: 16px;
        padding: 15px;
    }

    .ocean-table {
        margin-bottom: 0;
    }

    .ocean-table th {
        background-color: #f1f5f9 !important;
        color: #03045e !important;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
        padding: 15px 12px;
    }

    .ocean-table td {
        padding: 15px 12px;
        vertical-align: middle;
        color: #334155;
    }

    /* --- CẬP NHẬT KÍCH THƯỚC ẢNH TO, RÕ NÉT VÀ CÂN ĐỐI --- */
    .img-container-ocean {
        width: 140px;          /* Tăng chiều rộng khung ảnh */
        height: 85px;          /* Tăng chiều cao khung ảnh để giữ tỉ lệ vàng */
        overflow: hidden;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s;
    }

    .img-container-ocean:hover {
        transform: scale(1.06); /* Hiệu ứng zoom nhẹ khi di chuột vào ảnh nhìn rất sang */
        border-color: #00b4d8;
    }

    .img-thumbnail-ocean {
        width: 100%;
        height: 100%;
        object-fit: cover;    /* Đảm bảo ảnh không bị bóp méo, tự điền đầy khung hình */
    }

    .badge-count {
        background-color: #e0f7fa;
        color: #00838f;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 13px;
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold m-0" style="color: #0077b6 !important;"><i class="fas fa-map-marker-alt me-2"></i>Danh Sách Địa Điểm</h2>
        <p class="text-muted m-0 small">Quản lý các khu vực, tỉnh thành khai thác dịch vụ lưu trú.</p>
    </div>
    <a asp-action="Create" class="btn btn-ocean">
        <i class="fas fa-plus-circle me-2"></i>Thêm Địa Điểm Mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #e8f5e9; color: #2e7d32;">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #ffebee; color: #c62828;">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive shadow-sm">
    <table class="table ocean-table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 70px;" class="text-center">STT</th>
                <th style="width: 170px;" class="text-center">Hình ảnh</th>
                <th style="width: 220px;">Tên Địa Điểm / Tỉnh Thành</th>
                <th>Mô tả khu vực</th>
                <th class="text-center" style="width: 200px;">Số khách sạn trực thuộc</th>
                <th class="text-center" style="width: 140px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-secondary">@index</td>
                        <td class="text-center">
                            <div class="img-container-ocean mx-auto">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.jpg" : item.ImageUrl)" 
                                     class="img-thumbnail-ocean" alt="@item.Name" />
                            </div>
                        </td>
                        <td><strong class="text-dark fs-6">@item.Name</strong></td>
                        <td>
                            <div class="text-muted text-wrap" style="font-size: 14px; line-height: 1.5; max-height: 75px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                @item.Description
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="badge-count">
                                <i class="fas fa-building me-1"></i> @(item.Properties?.Count ?? 0) khách sạn
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" style="border-radius: 8px; padding: 6px 10px;" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa địa điểm này không?');" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px; padding: 6px 10px;" title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-5">
                        <i class="fas fa-folder-open d-block fs-2 mb-3 text-secondary"></i>
                        Chưa có dữ liệu địa điểm nào được tạo. Nhấn "Thêm Địa Điểm Mới" để bắt đầu!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>