@model IEnumerable<Web_Management_Booking_N4.Models.Booking>

@{
    ViewData["Title"] = "Quản Lý Đơn Đặt Phòng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header { border-bottom: 2px dashed #caf0f8; padding-bottom: 15px; margin-bottom: 30px; }
    .table-responsive { background: white; border-radius: 16px; padding: 15px; }
    .ocean-table th { background-color: #f1f5f9 !important; color: #03045e !important; font-weight: 600; padding: 15px 12px; }
    .ocean-table td { padding: 15px 12px; vertical-align: middle; color: #334155; }
    .price-total { color: #0284c7; font-weight: 700; font-size: 15px; }
    
    /* Cấu hình các Badge trạng thái sinh động */
    .badge-status { padding: 6px 12px; border-radius: 30px; font-weight: 600; font-size: 12px; display: inline-block; }
    .status-pending { background-color: #fef3c7; color: #d97706; }
    .status-confirmed { background-color: #dcfce7; color: #15803d; }
    .status-cancelled { background-color: #fee2e2; color: #b91c1c; }
</style>

<div class="page-header">
    <h2 class="fw-bold m-0" style="color: #0077b6 !important;"><i class="fas fa-file-invoice-dollar me-2"></i>Nhật Ký Đặt Phòng (Bookings)</h2>
    <p class="text-muted m-0 small">Theo dõi doanh thu, thông tin check-in/out của khách hàng và duyệt trạng thái đơn phòng.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #e8f5e9; color: #2e7d32;">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive shadow-sm">
    <table class="table ocean-table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 60px;" class="text-center">Mã Đơn</th>
                <th style="width: 200px;">Khách Hàng đặt</th>
                <th style="width: 250px;">Thông Tin Phòng & Cơ Sở</th>
                <th style="width: 180px;" class="text-center">Thời Gian Lưu Trú</th>
                <th style="width: 130px;" class="text-end">Tổng Doanh Thu</th>
                <th style="width: 140px;" class="text-center">Trạng Thái</th>
                <th class="text-center" style="width: 150px;">Thao tác nhanh</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-secondary">#@item.Id</td>
                        <td>
                            <strong class="text-dark d-block">@(item.User?.FullName ?? "Ẩn danh")</strong>
                            <small class="text-muted"><i class="fas fa-phone-alt me-1"></i> @(item.User?.Phone ?? "Không có")</small>
                        </td>
                        <td>
                            <span class="text-dark fw-semibold">@(item.Room?.RoomType ?? "N/A")</span>
                            <small class="text-muted d-block text-truncate" style="max-width: 230px;">
                                <i class="fas fa-hotel me-1 text-info"></i> @(item.Room?.Property?.Name ?? "Chưa rõ khách sạn")
                            </small>
                        </td>
                        <td class="text-center small text-secondary">
                            <div class="bg-light p-2 border rounded">
                                <div><strong>Vào:</strong> @item.CheckInDate.ToString("dd/MM/yyyy")</div>
                                <div class="border-top mt-1 pt-1"><strong>Ra:</strong> @item.CheckOutDate.ToString("dd/MM/yyyy")</div>
                            </div>
                        </td>
                        <td class="text-end">
                            <span class="price-total">@string.Format("{0:N0}", item.TotalPrice) đ</span>
                        </td>
                        <td class="text-center">
                            @if (item.Status == "Confirmed")
                            {
                                <span class="badge-status status-confirmed"><i class="fas fa-check-circle me-1"></i>Đã xác nhận</span>
                            }
                            else if (item.Status == "Cancelled")
                            {
                                <span class="badge-status status-cancelled"><i class="fas fa-times-circle me-1"></i>Đã hủy đơn</span>
                            }
                            else
                            {
                                <span class="badge-status status-pending"><i class="fas fa-clock me-1"></i>Chờ xử lý</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                @if (item.Status != "Confirmed" && item.Status != "Cancelled")
                                {
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="Confirmed" />
                                        <button type="submit" class="btn btn-sm btn-success" style="border-radius: 6px;"><i class="fas fa-check"></i> Duyệt</button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="Cancelled" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;"><i class="fas fa-ban"></i> Hủy</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Đã hoàn thành xử lý</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <i class="fas fa-receipt d-block fs-2 mb-3 text-secondary"></i>
                        Hệ thống chưa ghi nhận bất kỳ lịch sử đơn đặt phòng nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>