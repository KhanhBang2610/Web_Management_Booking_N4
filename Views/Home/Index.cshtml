@{
    ViewData["Title"] = "Bảng Điều Khiển Trung Tâm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .dashboard-header {
        border-bottom: 2px dashed #caf0f8;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }
    
    .metric-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .metric-card {
        background: white;
        border-radius: 16px;
        padding: 25px 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 15px rgba(0, 119, 182, 0.05);
        border: 1px solid #e2e8f0;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .metric-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 119, 182, 0.12);
    }

    .metric-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .metric-info h3 {
        font-size: 28px;
        font-weight: 700;
        margin: 0;
        color: #03045e;
    }

    .metric-info p {
        font-size: 13px;
        color: #64748b;
        margin: 2px 0 0 0;
        font-weight: 500;
    }

    /* Các tông màu chủ đề biển cho từng loại thẻ */
    .bg-success-light { background-color: #e8f5e9; color: #2e7d32; }
    .bg-money-light { background-color: #e0f7fa; color: #00838f; }
    .bg-warning-light { background-color: #fff3e0; color: #ef6c00; }
    .bg-avail-light { background-color: #e1f5fe; color: #0277bd; }
    .bg-booked-light { background-color: #f3e5f5; color: #6a1b9a; }

    .welcome-banner {
        background: linear-gradient(135deg, rgba(72, 202, 228, 0.1) 0%, rgba(0, 119, 182, 0.05) 100%);
        border-radius: 16px;
        padding: 30px;
        border: 1px solid rgba(72, 202, 228, 0.2);
    }
</style>

<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold text-dark m-0" style="color: #0077b6 !important;">Tổng Quan Vận Hành</h2>
        <p class="text-muted m-0 small">Dữ liệu kinh doanh và trạng thái phòng nghỉ theo thời gian thực.</p>
    </div>
    <div class="text-muted small font-monospace">
        <i class="far fa-clock me-1"></i> Hệ thống cập nhật tự động
    </div>
</div>

<div class="metric-grid">
    
    <div class="metric-card">
        <div class="metric-icon bg-success-light">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="metric-info">
            <h3>@ViewBag.SuccessCount</h3>
            <p>Đơn thành công</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon bg-money-light">
            <i class="fas fa-wallet"></i>
        </div>
        <div class="metric-info">
            <h3>@string.Format("{0:N0} đ", ViewBag.TotalRevenue)</h3>
            <p>Doanh thu thực tế</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon bg-warning-light">
            <i class="fas fa-hourglass-half"></i>
        </div>
        <div class="metric-info">
            <h3>@ViewBag.PendingCount</h3>
            <p>Đơn chờ duyệt</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon bg-avail-light">
            <i class="fas fa-door-open"></i>
        </div>
        <div class="metric-info">
            <h3>@ViewBag.AvailableRooms</h3>
            <p>Phòng còn trống</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon bg-booked-light">
            <i class="fas fa-bed"></i>
        </div>
        <div class="metric-info">
            <h3>@ViewBag.BookedRooms</h3>
            <p>Phòng đã đặt</p>
        </div>
    </div>

</div>

<div class="welcome-banner mt-4">
    <h5 class="fw-bold text-dark mb-2"><i class="fas fa-umbrella-beach me-2 text-info"></i>Chào mừng trở lại, Quản trị viên!</h5>
    <p class="m-0 text-secondary small" style="line-height: 1.6;">
        Hệ thống quản trị chuỗi lưu trú cao cấp <strong>Ocean Luxury</strong> hoạt động ổn định. 
        Bạn có thể sử dụng thanh trình đơn điều hướng bên trái để quản lý danh sách địa điểm du lịch, cập nhật thông tin chuỗi khách sạn hoặc trực tiếp phê duyệt các yêu cầu đặt phòng đang chờ xử lý từ khách hàng một cách nhanh chóng.
    </p>
</div>
